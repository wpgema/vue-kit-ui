{
    "name": "vue-kit-ui",
    "version": "0.1.0",
    "description": "A reusable Vue 3 UI component library designed for Tailwind CSS",
    "type": "module",
    "main": "dist/index.cjs.js",
    "module": "dist/index.es.js",
    "exports": {
        ".": {
        "import": "./dist/index.es.js",
        "require": "./dist/index.cjs.js"
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "vite build"
    },
    "keywords": [
        "vue",
        "vue3",
        "component-library",
        "ui-kit",
        "tailwind"
    ],
    "author": "M. Gema Maulana",
    "license": "MIT",
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.3",
        "vite": "^7.3.1"
    }
}
