{
    "name": "@gemamaulana/vue-kit-ui",
    "version": "0.1.0",
    "description": "A reusable Vue 3 UI component library designed for Tailwind CSS",
    "type": "module",
    "main": "dist/index.cjs.js",
    "module": "dist/index.es.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.cjs.js"
        }
    },
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "vite build"
    },
    "keywords": [
        "vue",
        "vue3",
        "component-library",
        "ui-kit",
        "tailwind"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/wpgema/vue-kit-ui.git"
    },
    "bugs": {
        "url": "https://github.com/wpgema/vue-kit-ui/issues"
    },
    "homepage": "https://github.com/wpgema/vue-kit-ui#readme",
    "author": "M. Gema Maulana",
    "license": "MIT",
    "peerDependencies": {
        "vue": "^3.3.0",
        "tailwindcss": "^3.0.0 || ^4.0.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.3",
        "vite": "^7.3.1"
    }
}
